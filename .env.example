# Copiar valores al entorno del hosting. Nunca guardar contraseñas aquí.
NODE_ENV=production
HOST=0.0.0.0
# En Render, PORT lo suministra la plataforma; no fijarlo al puerto local.
PUBLIC_ORIGIN=https://dominio-a-confirmar.example
DATA_DIR=/var/data

# Token PUBLICO de Web Analytics (no es una API key). Vacío desactiva la integración.
CLOUDFLARE_WEB_ANALYTICS_TOKEN=
